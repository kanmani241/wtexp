            padding: 25px;
        }

        header h1 {
            margin: 0;
        }

        .profile {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            border: 4px solid white;
        }


        /* NAVIGATION */

        nav {
            background-color: #34495e;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            color: #f1c40f;
        }


        /* MAIN - NORMAL FLOW */

        main {
            width: 90%;
            margin: 20px auto;
        }

        .box {
            background-color: white;
            padding: 20px;
            margin-bottom: 20px;
            border: 2px solid #ddd;
            border-radius: 8px;
        }

        .box h2 {
            color: #2c3e50;
        }


        /* SKILLS */

        li {
            margin: 10px;
        }


        /* CARDS */

        .card {
            background-color: #ecf0f1;
            padding: 15px;
            margin-top: 15px;
            border-left: 5px solid #3498db;
        }


        /* FORM */

        form {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
        }

        input,
        select,
        textarea {
            padding: 10px;
            border: 1px solid #aaa;
            border-radius: 5px;
            font-size: 15px;
        }

        input[type="text"],
        input[type="email"],
        input[type="tel"],
        input[type="date"],
        input[type="file"],
        select,
        textarea {
            width: 100%;
            box-sizing: border-box;
        }

        input[type="radio"],
        input[type="checkbox"] {
            width: auto;
        }

        input[type="submit"],
        input[type="reset"] {
            background-color: #2c3e50;
            color: white;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
            margin-right: 10px;
        }

        input[type="submit"]:hover,
        input[type="reset"]:hover {
            background-color: #3498db;
        }


        /* MULTI-COLUMN LAYOUT */

        .multicolumn {
            column-count: 3;
            column-gap: 30px;
            column-rule: 2px solid #ccc;
            text-align: justify;
        }


        /* ARTICLE */

        article {
            background-color: #ecf0f1;
            padding: 15px;
            margin-top: 15px;
            border-left: 5px solid #3498db;
        }


        /* ASIDE */

        aside {
            background-color: #fff3cd;
            padding: 15px;
