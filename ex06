
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Freelancer Portfolio</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f4f4;
            color: #333;
        }

        /* Navigation Bar */

        nav {
            height: 70px;
            background-color: #222;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 5%;
        }

        .logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 15px;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: white;
            padding: 10px 18px;
            border-radius: 5px;
        }

        .nav-links a:hover {
            background-color: #6c4cff;
        }

        /* Main Section */

        .main {
            min-height: 350px;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
            background-color: #eae6ff;
            text-align: center;
        }

        .profile h1 {
            color: #6c4cff;
            margin: 15px;
        }

        .profile img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
        }

        .profile p {
            margin: 15px;
        }

        /* Common Sections */

        .section {
            background-color: white;
            margin: 25px auto;
            padding: 30px;
            width: 85%;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        .section h2 {
            color: #6c4cff;
            margin-bottom: 15px;
            text-align: center;
        }

        .section p {
            text-align: center;
            line-height: 1.6;
        }

        /* Skills */

        .skills {
            text-align: center;
        }

        .skills span {
            display: inline-block;
            background-color: #6c4cff;
            color: white;
            padding: 12px 20px;
            margin: 8px;
            border-radius: 5px;
            cursor: pointer;
        }

        .skills span:hover {
            background-color: #5438d4;
        }

        /* Projects */

        .project {
            background-color: #f4f4f4;
            padding: 20px;
            margin: 15px 0;
            border-left: 5px solid #6c4cff;
            border-radius: 5px;
        }

        .project h3 {
            color: #5438d4;
            margin-bottom: 8px;
        }

        /* Buttons */

        button {
            padding: 12px 20px;
            background-color: #6c4cff;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 15px;
        }

        button:hover {
            background-color: #5438d4;
        }

        /* Contact Form */

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #6c4cff;
        }

        .submit-btn {
            width: 100%;
            padding: 12px;
            background-color: #6c4cff;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
        }

        #message {
            color: green;
            text-align: center;
            margin-top: 15px;
        }

        /* Footer */

        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 20px;
        }

        /* Responsive Design */

        @media(max-width: 600px) {
            nav {
                height: auto;
                flex-direction: column;
                padding: 15px;
                gap: 15px;
            }

            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 5px;
            }

            .section {
                width: 95%;
            }
        }

    </style>
</head>

<body>

    <!-- Navigation Bar -->

    <nav>

        <div class="logo">MyPortfolio</div>

        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>

    </nav>

    <!-- Home Section -->

    <main class="main" id="home">

        <div class="profile">

            <img src="https://via.placeholder.com/120"
                 alt="Profile Image">

            <h1 id="name">John Freelancer</h1>

            <h3>Web Developer | Designer</h3>

            <p id="description">
                I create modern and responsive websites
                for clients.
            </p>

            <button onclick="changeName()">
                Change Name
            </button>

            <button onclick="hireMe()">
                Hire Me
            </button>

            <p id="hireMessage"></p>

        </div>

    </main>

    <!-- About Section -->

    <section class="section" id="about">

        <h2>About Me</h2>

        <p id="aboutText">
            I am a passionate freelancer interested
            in web development and creative design.
        </p>

        <center>
            <button onclick="readMore()">
                Read More
            </button>
        </center>

    </section>

    <!-- Skills Section -->

    <section class="section" id="skills">

        <h2>My Skills</h2>

        <div class="skills">

            <span onmouseover="showSkill('HTML')">HTML</span>

            <span onmouseover="showSkill('CSS')">CSS</span>

            <span onmouseover="showSkill('JavaScript')">
                JavaScript
            </span>

            <span onmouseover="showSkill('Python')">Python</span>

            <span onmouseover="showSkill('Java')">Java</span>

        </div>

        <p id="skillMessage">
            Move the mouse over a skill.
        </p>

    </section>

    <!-- Projects Section -->

    <section class="section" id="projects">

        <h2>My Projects</h2>

        <div class="project">

            <h3>Portfolio Website</h3>

            <p>Personal portfolio website development.</p>

        </div>

        <div class="project">

            <h3>E-Commerce Website</h3>

            <p>Online shopping website development.</p>

        </div>

        <div class="project">

            <h3>Travel Website</h3>

            <p>Travel booking and management website.</p>

        </div>

        <center>
            <button onclick="addProject()">
                Add Project
            </button>
        </center>

        <div id="newProject"></div>

    </section>

    <!-- Contact Section -->

    <section class="section" id="contact">

        <h2>Contact Me</h2>

        <form onsubmit="submitForm(event)">

            <div class="form-group">

                <label>Name</label>

                <input type="text" id="username"
                       placeholder="Enter your name" required>

            </div>

            <div class="form-group">

                <label>Email</label>

                <input type="email" id="email"
                       placeholder="Enter your email" required>

            </div>

            <div class="form-group">

                <label>Message</label>

                <textarea id="userMessage"
                          placeholder="Enter your message"
                          required></textarea>

            </div>

            <button class="submit-btn" type="submit">
                Send Message
            </button>

        </form>

        <p id="message"></p>

    </section>

    <!-- Footer -->

    <footer>

        <p>Freelancer Portfolio | Responsive Webpage</p>

        <p>© 2026 All Rights Reserved</p>

    </footer>

    <!-- JavaScript DOM Elements and Events -->

    <script>

        // Change Name using onclick

        function changeName() {

            document.getElementById("name").innerHTML =
                "Professional Freelancer";

        }

        // Hire Me using onclick

        function hireMe() {

            document.getElementById("hireMessage").innerHTML =
                "Thank you! Let's work together.";

        }

        // Read More using onclick

        function readMore() {

            document.getElementById("aboutText").innerHTML =
                "I have knowledge of HTML, CSS, JavaScript, Python and Java. I develop responsive and user-friendly websites.";

        }

        // Display Skills using onmouseover

        function showSkill(skill) {

            document.getElementById("skillMessage").innerHTML =
                "Selected Skill: " + skill;

        }

        // Add Project using onclick

        function addProject() {

            document.getElementById("newProject").innerHTML +=
                "<div class='project'><h3>New Project</h3>" +
                "<p>Project added successfully!</p></div>";

        }

        // Contact Form using onsubmit

        function submitForm(event) {

            event.preventDefault();

            let name =
                document.getElementById("username").value;

            document.getElementById("message").innerHTML =
                "Thank you " + name + "! Message submitted successfully.";

        }

        // Header using onmouseover

        document.querySelector("nav").onmouseover = function() {

            this.style.backgroundColor = "#5438d4";

        };

        // Header using onmouseout

        document.querySelector("nav").onmouseout = function() {

            this.style.backgroundColor = "#222";

        };

        // Profile using ondblclick

        document.getElementById("description").ondblclick =
        function() {

            this.style.color = "#6c4cff";
            this.style.fontWeight = "bold";

        };

        // Email using onchange

        document.getElementById("email").onchange = function() {

            alert("Email entered: " + this.value);

        };

        // Name using onkeydown

        document.getElementById("username").onkeydown =
        function() {

            console.log("Keyboard key pressed");

        };

    </script>

</body>
</html>
