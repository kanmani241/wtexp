<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Responsive Web Design</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: white;
            color: black;
        }

        header {
            width: 100%;
            background-color: white;
            border-bottom: 1px solid black;
        }

        .navbar {
            width: 90%;
            max-width: 1100px;
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 15px 0;
        }

        .logo {
            font-size: 20px;
            font-weight: bold;
            color: black;
        }

        .nav-links {
            display: flex;
            gap: 25px;
        }

        .nav-links a {
            color: black;
            text-decoration: none;
            font-weight: bold;
            padding: 8px 12px;
        }

        .nav-links a:hover {
            background-color: black;
            color: white;
        }

        .nav-links a:active {
            background-color: black;
            color: white;
        }

        .hero {
            background-color: #8faeaa;

            min-height: 230px;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

            padding: 30px;
        }

        .hero h1 {
            color: white;

            font-size: 42px;

            font-weight: bold;

            letter-spacing: 2px;

            margin: 0;
        }

        .container {
            width: 90%;
            max-width: 1100px;

            margin: 35px auto;
        }

        .topics {
            display: grid;

            grid-template-columns:
            repeat(3, 1fr);

            gap: 30px;
        }

        .topic {
            background-color: white;

            border: 1px solid black;

            padding: 15px;

            margin-bottom: 20px;
        }

        .topic h2 {
            color: black;

            background-color: white;

            font-size: 20px;

            font-weight: bold;

            text-align: center;

            margin: 0 0 15px 0;

            padding: 10px;

            border: 1px solid black;
        }

        .topic p {
            color: black;

            font-size: 15px;

            font-weight: bold;

            line-height: 1.6;

            text-align: justify;

            margin-top: 10px;
        }

        .margin-topic {
            margin-top: 25px;

            margin-bottom: 25px;

            margin-left: 10px;

            margin-right: 10px;
        }

        .text-topic {
            color: black;

            letter-spacing: 1px;

            text-align: justify;

            font-weight: bold;
        }

        .font-topic {
            font-family: Georgia, serif;

            font-style: italic;

            font-weight: bold;

            font-size: 18px;
        }

        .background-topic {
            background-color: white;

            padding: 15px;

            border: 1px solid black;

            color: black;

            font-weight: bold;
        }

        .multicolumn {
            column-count: 3;

            column-gap: 25px;

            column-rule: 1px solid black;

            text-align: justify;

            font-weight: bold;

            color: black;
        }

        .padding-topic {
            padding-top: 20px;

            padding-bottom: 20px;

            padding-left: 20px;

            padding-right: 20px;

            border: 1px solid black;

            font-weight: bold;

            color: black;
        }

        .display-inline {
            display: inline;

            border: 1px solid black;

            padding: 5px;

            font-weight: bold;

            color: black;
        }

        .display-block {
            display: block;

            border: 1px solid black;

            padding: 10px;

            margin-top: 10px;

            font-weight: bold;

            color: black;
        }

        .topic ul {
            list-style-type: circle;

            padding-left: 25px;
        }

        .topic li {
            padding: 5px;

            font-weight: bold;

            color: black;
        }

        .topic a {
            color: black;

            font-weight: bold;

            text-decoration: underline;
        }

        footer {
            background-color: white;

            border-top: 1px solid black;

            text-align: center;

            padding: 20px;

            margin-top: 30px;
        }

        footer p {
            font-weight: bold;

            color: black;
        }

        .contact-box {
            width: 90%;

            max-width: 500px;

            margin: 20px auto;

            padding: 15px;

            border: 1px solid black;

            background-color: white;

            text-align: left;
        }

        .contact-box h2 {
            color: black;

            text-align: center;

            font-size: 20px;

            font-weight: bold;

            padding: 10px;

            margin-top: 0;

            border: 1px solid black;
        }

        .contact-box p {
            color: black;

            font-weight: bold;

            font-size: 15px;

            line-height: 1.6;

            margin: 8px 0;
        }

        @media screen and (max-width: 768px) {

            .navbar {
                flex-direction: column;
            }

            .nav-links {
                margin-top: 15px;

                flex-wrap: wrap;

                justify-content: center;
            }

            .hero h1 {
                font-size: 30px;
            }

            .topics {
                grid-template-columns:
                repeat(2, 1fr);
            }

            .multicolumn {
                column-count: 2;
            }
        }

        @media screen and (max-width: 480px) {

            .nav-links {
                flex-direction: column;

                gap: 5px;

                text-align: center;
            }

            .hero {
                min-height: 180px;
            }

            .hero h1 {
                font-size: 24px;
            }

            .topics {
                grid-template-columns: 1fr;
            }

            .multicolumn {
                column-count: 1;
            }

            .contact-box {
                width: 85%;
            }
        }

    </style>

</head>

<body>

    <header>

        <div class="navbar">

            <div class="logo">
                WEB DESIGN
            </div>

            <nav class="nav-links">

                <a href="#home">Home</a>

                <a href="#topics">Topics</a>

                <a href="#about">About</a>

                <a href="#contact">Contact</a>

            </nav>

        </div>

    </header>

    <section class="hero" id="home">

        <h1>
            RESPONSIVE WEB DESIGN
        </h1>

    </section>

    <main class="container" id="topics">

        <div class="topics">

            <article class="topic">

                <h2>
                    MARGINS
                </h2>

                <p class="margin-topic">

                    The margin property creates space
                    outside an HTML element.

                    CSS provides margin-top,
                    margin-bottom,
                    margin-left and margin-right.

                </p>

            </article>

            <article class="topic">

                <h2>
                    FORMATTING TEXT
                </h2>

                <p class="text-topic">

                    CSS provides different properties
                    for formatting text.

                    These include color,
                    letter-spacing,
                    text-align and text-shadow.

                </p>

            </article>

            <article class="topic">

                <h2>
                    FONT
                </h2>

                <p class="font-topic">

                    CSS font properties include
                    font-family, font-style,
                    font-weight and font-size.

                </p>

            </article>

            <article class="topic">

                <h2>
                    BACKGROUND
                </h2>

                <p class="background-topic">

                    Background properties are used
                    to define the background effects
                    of HTML elements.

                    Background color and
                    background image can be used.

                </p>

            </article>

            <article class="topic">

                <h2>
                    PADDING
                </h2>

                <p class="padding-topic">

                    Padding creates space between
                    the content and the border
                    of an HTML element.

                </p>

            </article>

            <article class="topic">

                <h2>
                    DISPLAY
                </h2>

                <p>

                    <span class="display-inline">
                        INLINE
                    </span>

                </p>

                <p class="display-block">
                    BLOCK
                </p>

            </article>

            <article class="topic">

                <h2>
                    LIST
                </h2>

                <ul>

                    <li>Margin</li>

                    <li>Padding</li>

                    <li>Font</li>

                    <li>Background</li>

                    <li>Display</li>

                </ul>

            </article>

            <article class="topic">

                <h2>
                    MULTICOLUMN
                </h2>

                <div class="multicolumn">

                    CSS3 provides a
                    multicolumn layout
                    for displaying content
                    in multiple columns.

                </div>

            </article>

            <article class="topic">

                <h2>
                    LINKS
                </h2>

                <p>

                    CSS can style hyperlinks
                    using link, visited,
                    hover and active states.

                </p>

            </article>

        </div>

    </main>

    <footer id="about">

        <p>
            Responsive Webpage Using HTML5 and CSS3
        </p>

        <div class="contact-box" id="contact">

            <h2>
                CONTACT INFO
            </h2>

            <p>
                <strong>Name:</strong>
                Ysinshree
            </p>

            <p>
                <strong>Mail ID:</strong>
                ysinshree@gmail.com
            </p>

            <p>
                <strong>Phone Number:</strong>
                +91 98765 43210
            </p>

            <p>
                <strong>Address:</strong>
                Coimbatore, Tamil Nadu, India
            </p>

        </div>

        <p>
            Web Design Practical
        </p>

    </footer>

</body>

</html>







#sign in and sign up website#

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Webpage - Login</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f4f4;
            color: #333;
        }

        /* Navigation Bar */
        nav {
            height: 70px;
            background-color: #222;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 8%;
        }

        .logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 15px;
        }

        .nav-links a {
            text-decoration: none;
            color: white;
            padding: 10px 18px;
            border-radius: 5px;
        }

        .nav-links a:hover {
            background-color: #555;
        }

        .signup-btn {
            background-color: #6c4cff;
        }

        .signin-btn {
            border: 1px solid white;
        }

        /* Main Area */
        .main {
            min-height: calc(100vh - 70px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px;
        }

        /* Form Box */
        .form-box {
            width: 380px;
            background-color: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }

        .form-box h2 {
            text-align: center;
            margin-bottom: 10px;
        }

        .form-box p {
            text-align: center;
            color: #777;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
        }

        .form-group input:focus {
            outline: none;
            border-color: #6c4cff;
        }

        .submit-btn {
            width: 100%;
            padding: 12px;
            background-color: #6c4cff;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
        }

        .submit-btn:hover {
            background-color: #5438d4;
        }

        .switch {
            margin-top: 20px;
            text-align: center;
        }

        .switch a {
            color: #6c4cff;
            text-decoration: none;
            font-weight: bold;
        }

        /* Hide Sign Up initially */
        #signup {
            display: none;
        }

        /* Mobile */
        @media (max-width: 600px) {

            nav {
                padding: 0 4%;
            }

            .logo {
                font-size: 20px;
            }

            .nav-links {
                gap: 5px;
            }

            .nav-links a {
                padding: 8px;
                font-size: 13px;
            }

            .form-box {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>

        <div class="logo">
            MyWebsite
        </div>

        <div class="nav-links">
            <a href="#">Home</a>

            <a href="#signin"
               class="signin-btn"
               onclick="showSignIn()">
                Sign In
            </a>

            <a href="#signup"
               class="signup-btn"
               onclick="showSignUp()">
                Sign Up
            </a>
        </div>

    </nav>


    <div class="main">

        <!-- SIGN IN -->
        <div class="form-box" id="signin">

            <h2>Welcome Back</h2>

            <p>Sign in to your account</p>

            <form onsubmit="login(event)">

                <div class="form-group">

                    <label>Email</label>

                    <input
                        type="email"
                        placeholder="example@gmail.com"
                        maxlength="50"
                        required>

                </div>

                <div class="form-group">

                    <label>Password</label>

                    <input
                        type="password"
                        placeholder="Enter password"
                        minlength="6"
                        maxlength="20"
                        required>

                </div>

                <button class="submit-btn" type="submit">
                    Sign In
                </button>

            </form>

            <div class="switch">

                Don't have an account?

                <a href="#signup" onclick="showSignUp()">
                    Sign Up
                </a>

            </div>

        </div>


        <!-- SIGN UP -->
        <div class="form-box" id="signup">

            <h2>Create Account</h2>

            <p>Sign up to get started</p>

            <form onsubmit="register(event)">

                <div class="form-group">

                    <label>Name</label>

                    <input
                        type="text"
                        placeholder="Enter your name"
                        minlength="3"
                        maxlength="20"
                        pattern="[A-Za-z ]+"
                        title="Name should contain only letters"
                        required>

                </div>

                <div class="form-group">

                    <label>Email</label>

                    <input
                        type="email"
                        placeholder="example@gmail.com"
                        maxlength="50"
                        required>

                </div>

                <div class="form-group">

                    <label>Password</label>

                    <input
                        id="password"
                        type="password"
                        placeholder="6-20 characters"
                        minlength="6"
                        maxlength="20"
                        required>

                </div>

                <div class="form-group">

                    <label>Confirm Password</label>

                    <input
                        id="confirmPassword"
                        type="password"
                        placeholder="Confirm password"
                        minlength="6"
                        maxlength="20"
                        required>

                </div>

                <button class="submit-btn" type="submit">
                    Create Account
                </button>

            </form>

            <div class="switch">

                Already have an account?

                <a href="#signin" onclick="showSignIn()">
                    Sign In
                </a>

            </div>

        </div>

    </div>


    <script>

        function showSignIn() {

            document.getElementById("signin").style.display = "block";

            document.getElementById("signup").style.display = "none";
        }


        function showSignUp() {

            document.getElementById("signin").style.display = "none";

            document.getElementById("signup").style.display = "block";
        }


        function login(event) {

            event.preventDefault();

            alert("Sign In successful!");

        }


        function register(event) {

            event.preventDefault();

            let password =
                document.getElementById("password").value;

            let confirmPassword =
                document.getElementById("confirmPassword").value;

            if (password !== confirmPassword) {

                alert("Passwords do not match!");

                return;
            }

            alert("Account created successfully!");

        }

    </script>

</body>
</html>
