            border: 4px solid white;
        }

        nav {
            background-color: #34495e;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            color: #f1c40f;
        }
        main {
            width: 90%;
            margin: 20px auto;
        }
        .box {
            background-color: white;
            padding: 20px;
            margin-bottom: 20px;
            border: 2px solid #ddd;
            border-radius: 8px;
        }
        .box h2 {
            color: #2c3e50;
        }

        li {
            margin: 10px;
        }
        .card {
            background-color: #ecf0f1;
            padding: 15px;
            margin-top: 15px;
            border-left: 5px solid #3498db;
        }

        form {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
        }
        input,
        select,
        textarea {
            padding: 10px;
            border: 1px solid #aaa;
            border-radius: 5px;
            font-size: 15px;
        }
        input[type="text"],
        input[type="email"],
        input[type="tel"],
        input[type="date"],
        input[type="file"],
        select,
        textarea {
            width: 100%;
            box-sizing: border-box;
        }

        input[type="radio"],
        input[type="checkbox"] {
            width: auto;
